APP_NAME="Tekoovi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database — MongoDB
# --------------------------------------------------------------------------
# The only database this app uses. `mongodb` must stay the default connection;
# there are no SQL migrations and nothing expects a relational store.

DB_CONNECTION=mongodb
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE=tekoovi

# --------------------------------------------------------------------------
# Sessions
# --------------------------------------------------------------------------
# The admin signs in through an ordinary Laravel session, so the driver has to
# persist between requests — `file` needs nothing but a writable storage dir.
# Set SESSION_SECURE_COOKIE=true once the site is served over HTTPS.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Admin panel
# --------------------------------------------------------------------------
# A single operator. Prefer ADMIN_PASSWORD_HASH — generate one with
#   php artisan admin:hash "your-password"
# and leave ADMIN_PASSWORD unset, so the plaintext password never lives in a
# file. ADMIN_PASSWORD is the fallback that keeps older installs working.

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# --------------------------------------------------------------------------
# Media
# --------------------------------------------------------------------------
# Uploaded images live in MongoDB and are served from /api/media/{id}. Leaving
# MEDIA_BASE_URL empty keeps stored paths relative, so the same database works
# on localhost, staging and production untouched. Set it only to serve images
# from somewhere else, e.g. https://cdn.example.com.

MEDIA_BASE_URL=
MEDIA_MAX_BYTES=8388608
